data/*.pth
data/*.pkl
data/*.npz
data/*.h5
data/*.hdf5
data/imageNet_images/
data/eeg_55_95_std.pth
data/block_splits_by_image_all.pth
!data/captions_with_bbox_data.pth
!data/imagenet_class_labels.txt

